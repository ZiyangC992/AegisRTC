  LINK_LIBRARIES = -Wl,-rpath,/home/charleachen/AegisRTC/D:/vcpkg/installed/x64-windows/lib  -lavcodec  -lavutil  -lswscale
  LINK_PATH = -L/home/charleachen/AegisRTC/D:/vcpkg/installed/x64-windows/lib
  OBJECT_DIR = CMakeFiles/aegis_video_encoder_factory_test.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/aegis_video_encoder_factory_test.dir/
  TARGET_FILE = aegis_video_encoder_factory_test
  TARGET_PDB = aegis_video_encoder_factory_test.pdb


